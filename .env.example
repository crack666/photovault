# Wohin PhotoVault schaut. Der einzige Wert, den du setzen musst.
#
#   Linux/macOS   PHOTO_DIR=/srv/fotos
#   Windows       PHOTO_DIR=D:/Fotos
#   WSL           PHOTO_DIR=/mnt/d/Fotos
#   NAS-Freigabe  vorher mounten, dann den Mountpunkt eintragen
#
# Innerhalb des Containers liegt alles unter /photos -- die Quellenliste in
# sources.txt bezieht sich also auf /photos/..., nicht auf den Hostpfad.
PHOTO_DIR=/pfad/zu/deinen/fotos

# Ports auf dem Host, falls 8000 oder 6333 schon belegt sind.
API_PORT=8000
QDRANT_PORT=6333

# Optional: Bildbeschreibungen und Text-Embeddings. Vorgabe ist LiteLLM
# (`local` / `embedder`) — welches Gewicht dahinter liegt, steht nur dort, und
# dort sitzt auch das GPU-Tor. Ohne LiteLLM: PHOTOVAULT_LLM=ollama und
# OLLAMA_URL setzen, dann geht es an Ollama direkt (ohne GPU-Tor; Modelle
# dann als Ollama-Tags, Vorgabe qwen3.8:27b / qwen3-embedding:4b).
# Ohne beides funktioniert alles andere weiter, nur Captions und Freitext
# entfallen.
# PHOTOVAULT_LLM=ollama
# OLLAMA_URL=http://host.docker.internal:11434
PHOTOVAULT_CAPTION_MODEL=local
# 0 = Kontext des LiteLLM-Pools. Nicht 8192 an `local` schicken:
# das laedt ein zweites KV und macht Captions langsamer.
PHOTOVAULT_CAPTION_NUM_CTX=0
# Text-Embed über LiteLLM-Pool `embedder`.
# Key: derselbe LITELLM_MASTER_KEY wie in D:\ai\ai-stack\.env — nicht committen.
LITELLM_URL=http://host.docker.internal:4000
PHOTOVAULT_EMBED_MODEL=embedder
