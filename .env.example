# Was start.bat / start.sh hier eintragen. Der Fotoordner steht NICHT mehr
# hier: die Laufwerke kommen aus docker-compose.override.yml, die gewählten
# Ordner aus data/sources.txt -- beides schreibt der Setup-Wizard.

# Ports auf dem Host. start.bat nimmt die nächsten freien, wenn diese belegt sind.
API_PORT=8000
QDRANT_PORT=6333

# Grafikspeicher in MB, gemessen von start.bat per nvidia-smi; 0 = keine
# NVIDIA-Karte. Der Wizard schlägt danach das Modell vor.
GPU_VRAM_MB=0

# Ollama läuft auf dem Host; der Wizard erkennt es dort. Modelle und Modus
# stehen in data/settings.json, nicht hier -- was hier steht, gewinnt immer
# (Umgebung > Datei). Nur setzen, wer weiß, warum.
OLLAMA_URL=http://host.docker.internal:11434
#PHOTOVAULT_CAPTION_MODEL=
#PHOTOVAULT_EMBED_MODEL=
#PHOTOVAULT_CAPTION_NUM_CTX=0

# Nur für einen LiteLLM-Pool (Entwicklungsmaschine): dann sind die Modell-
# namen Pool-Aliasse (`local` / `embedder`), und der Wizard hat nichts zu
# tun. Key nicht committen.
#LITELLM_URL=http://host.docker.internal:4000
#PHOTOVAULT_CAPTION_MODEL=local
#PHOTOVAULT_EMBED_MODEL=embedder
